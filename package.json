{
  "name": "loup-garou-bot",
  "version": "1.0.0",
  "description": "Bot WhatsApp du jeu du Loup-Garou (garde, sorcière, chasseur, voyante bavarde, loups, villageois)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node index.js",
    "start": "pm2 start ecosystem.config.cjs",
