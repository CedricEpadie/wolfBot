# Préfixe des commandes
PREFIX=/
# Dossier de la session WhatsApp (à placer sur un volume persistant en hébergement)
# AUTH_DIR=./auth
# Optionnel : numéro du bot (indicatif inclus, sans +) pour se lier par code au lieu du QR
# PAIRING_NUMBER=237600000000

# Cartes envoyées en privé : photo (image avec emoji, recommandé) ou text
ROLE_DELIVERY=photo
# Suppression automatique des cartes privées après N secondes (0 = jamais)
ROLE_SELF_DESTRUCT=60
# Efface la conversation privée côté bot juste après chaque envoi
WIPE_DM_CHAT=true

# Groupe secret des loups (créé par le bot pour la partie) :
#  keep  = le groupe est fermé sauf pendant l'étape de nuit des loups : la carte « Qui dévorer ? » y est envoyée,
#          les loups votent en envoyant un numéro ; les morts sont retirés et le groupe est DISSOUS à la fin (recommandé)
#  leave = le bot crée le groupe puis le quitte aussitôt ; les votes passent alors par des cartes privées
#  off   = pas de groupe : cartes de vote privées + relais des messages des loups par le bot
WOLF_GROUP=keep

# Voyante bavarde : annoncer aussi le NOM du joueur sondé (false = seulement son rôle)
VOYANTE_REVEAL_NAME=false
# Révéler le rôle des joueurs morts. Si true, le bot n'annonce plus le réveil d'un rôle dont le joueur est éliminé.
# Si false, il continue d'annoncer toutes les étapes de nuit (sinon se taire révélerait le rôle du mort).
REVEAL_ROLES=true
# Les morts ne parlent plus : delete = le bot supprime leurs messages dans le groupe (il doit être admin) • off = rien
DEAD_SILENCE=delete
# Nombre minimum de joueurs (6 minimum pour que tous les rôles existent)
# MIN_PLAYERS=6

# Maire élu au jour 1 : voix double, tranche les égalités, désigne son successeur (false = désactivé)
MAYOR=true

# Données persistantes (statistiques + sauvegarde des parties) — à placer sur un volume persistant en hébergement
DATA_DIR=./data
# Reprendre les parties interrompues par un redémarrage (au début de la phase en cours)
RESUME_GAMES=true
# Au-delà de ce délai (minutes), une partie sauvegardée est abandonnée
RESUME_MAX_MINUTES=120

# Règles, rôles et composition : photo (images lisibles) ou text
INFO_DELIVERY=photo
